# Public site identity — production values are set in the deployment environment only.
NEXT_PUBLIC_SITE_NAME=Odhvica
NEXT_PUBLIC_SITE_URL=https://example.com

# PostgreSQL and application security — never commit live values.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/odhvica
BETTER_AUTH_SECRET=replace_with_a_long_random_secret
BETTER_AUTH_URL=https://staging.example.com

# Payment provider credentials — sandbox is the safe default. Set live only after client approval.
ODHVICA_PAYMENT_MODE=sandbox
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Transactional email — live configuration requires a client-owned verified sender domain.
ODHVICA_EMAIL_MODE=sandbox
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_SENDER_NAME=

# Client-owned integrations — keep empty until approved accounts are available.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
ODHVICA_ANALYTICS_MODE=sandbox
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
GOOGLE_SEARCH_CONSOLE_VERIFICATION=
