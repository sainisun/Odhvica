# Public site identity — production values are set in the deployment environment only.
NEXT_PUBLIC_SITE_NAME=Odhvica
NEXT_PUBLIC_SITE_URL=https://example.com

# PostgreSQL and application security — never commit live values.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/odhvica
BETTER_AUTH_SECRET=replace_with_a_long_random_secret
BETTER_AUTH_URL=http://localhost:3000

# Payment provider credentials — configure only after Phase 0 provider approval.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
PAYPAL_CLIENT_ID=

# Client-owned integrations — keep empty until approved accounts are available.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
GA4_MEASUREMENT_ID=
META_PIXEL_ID=
GOOGLE_SEARCH_CONSOLE_VERIFICATION=
